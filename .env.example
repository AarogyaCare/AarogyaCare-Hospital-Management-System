# =============================================================================
# Aarogya Care Hospital Management System — Environment Configuration Template
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit your actual '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB 7.0)
# -----------------------------------------------------------------------------
# Connection URI for authoritative MongoDB document database
MONGODB_URI=mongodb://localhost:27017/aarogya

# -----------------------------------------------------------------------------
# Cache & Rate Limiting Configuration (Redis 5.0 / 7.0)
# -----------------------------------------------------------------------------
# Hostname and port for Redis cache-aside store and distributed rate limiter
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Backend Core Configuration (Spring Boot 3.4.3)
# -----------------------------------------------------------------------------
# HTTP server listening port
SERVER_PORT=8000

# Cryptographic signing key for HS256 JWT tokens.
# REQUIRED: Must be a random, high-entropy secret string at least 256 bits (32+ characters) long.
# Example generator: openssl rand -base64 32
AAROGYA_SECURITY_JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key-at-least-32-chars!

# JWT token expiration time in milliseconds (Default: 86400000 ms = 24 hours)
AAROGYA_SECURITY_JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Frontend Client Configuration (React 19 + TypeScript + Vite)
# -----------------------------------------------------------------------------
# Base URL for backend REST API endpoints consumed by Vite client
VITE_API_BASE_URL=http://localhost:8000

